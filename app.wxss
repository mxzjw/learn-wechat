page {
    background: #fdf8f3;
    color: #2f2a26;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
    font-size: 28rpx;
    line-height: 1.5;
}

.page {
    padding: 24rpx 28rpx 60rpx;
    box-sizing: border-box;
}

.page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 12rpx 4rpx 28rpx;
}

.page-title {
    display: block;
    font-size: 46rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
    color: #2b2320;
}

.page-sub {
    display: block;
    margin-top: 6rpx;
    font-size: 24rpx;
    color: #a89c92;
}

.card {
    background: #ffffff;
    border-radius: 28rpx;
    padding: 28rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 8rpx 28rpx rgba(171, 132, 96, 0.08);
}

.card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18rpx;
}

.card-title text {
    font-size: 30rpx;
    font-weight: 600;
    color: #3a3129;
}

.section-label {
    font-size: 24rpx;
    color: #a89c92;
}

.primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 76rpx;
    padding: 0 34rpx;
    border-radius: 38rpx;
    background: linear-gradient(135deg, #f6a35c, #e0762f);
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 600;
    box-shadow: 0 10rpx 22rpx rgba(224, 118, 47, 0.24);
}

.primary-btn:active {
    opacity: 0.86;
}

.ghost-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 76rpx;
    padding: 0 34rpx;
    border-radius: 38rpx;
    background: #ffffff;
    color: #e0762f;
    font-size: 28rpx;
    font-weight: 600;
    border: 2rpx solid rgba(224, 118, 47, 0.34);
}

.hint {
    padding: 60rpx 0;
    text-align: center;
    color: #a89c92;
    font-size: 26rpx;
}

.empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 90rpx 40rpx;
}

.empty-emoji {
    font-size: 96rpx;
    line-height: 1;
}

.empty-title {
    margin-top: 24rpx;
    font-size: 32rpx;
    font-weight: 600;
    color: #3a3129;
}

.empty-desc {
    margin: 12rpx 0 34rpx;
    font-size: 26rpx;
    color: #a89c92;
    text-align: center;
    line-height: 1.6;
}

.badge {
    display: inline-flex;
    align-items: center;
    margin-right: 12rpx;
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
    font-size: 22rpx;
    line-height: 1.3;
}

.badge-ok {
    color: #4b8a5f;
    background: #ecf6ee;
}

.badge-warn {
    color: #c1731c;
    background: #fdf0df;
}

.badge-danger {
    color: #c2433a;
    background: #fdeceb;
}

.badge-muted {
    color: #a89c92;
    background: #f4efe9;
}
