<view class="page">
    <view class="page-head">
        <view class="head-text">
            <text class="page-title">健康提醒</text>
            <text class="page-sub">{{summaryText}}</text>
        </view>
    </view>

    <view wx:if="{{loading}}" class="hint">正在整理提醒事项…</view>

    <view wx:elif="{{!hasCats}}" class="empty">
        <text class="empty-emoji">🐾</text>
        <text class="empty-title">还没有猫咪档案</text>
        <text class="empty-desc">先添加猫咪，再为它设置驱虫和疫苗时间。</text>
        <view class="primary-btn" bindtap="onGoHome">去添加猫咪</view>
    </view>

    <block wx:else>
        <view wx:if="{{items.length === 0}}" class="empty">
            <text class="empty-emoji">📅</text>
            <text class="empty-title">暂无待办提醒</text>
            <text class="empty-desc">在猫咪详情页设置下次驱虫、疫苗时间后，这里会自动倒计时。</text>
        </view>

        <view class="reminder-list">
            <view
                class="reminder-card level-{{item.level}}"
                wx:for="{{items}}"
                wx:key="key"
                data-id="{{item.catId}}"
                bindtap="onOpenCat"
            >
                <view class="r-avatar">
                    <image wx:if="{{item.avatar}}" class="r-avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
                    <text wx:else class="r-avatar-emoji">{{item.emoji}}</text>
                </view>
                <view class="r-main">
                    <view class="r-title-row">
                        <text class="r-cat">{{item.catName}}</text>
                        <text class="r-type">{{item.typeLabel}}</text>
                    </view>
                    <text class="r-date">{{item.dateText}}</text>
                </view>
                <view class="r-right">
                    <text class="r-days">{{item.daysText}}</text>
                    <text class="r-tip">{{item.tipText}}</text>
                </view>
            </view>
        </view>

        <view wx:if="{{unsetCount > 0}}" class="foot-tip">另有 {{unsetCount}} 项健康计划未设置时间，可进入猫咪详情补充</view>
        <view wx:else class="foot-tip">所有猫咪的健康计划都已设置</view>
    </block>
</view>
