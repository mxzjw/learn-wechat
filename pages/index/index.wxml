<view class="page">
    <view class="page-head">
        <view class="head-text">
            <text class="page-title">我的猫咪</text>
            <text class="page-sub">{{subtitle}}</text>
        </view>
        <view class="add-btn" bindtap="onAdd">＋ 添加猫咪</view>
    </view>

    <view wx:if="{{loading}}" class="hint">正在整理猫咪档案…</view>

    <view wx:elif="{{cats.length === 0}}" class="empty">
        <text class="empty-emoji">🐾</text>
        <text class="empty-title">还没有猫咪档案</text>
        <text class="empty-desc">添加第一只猫咪，开始记录每次称重的体重变化，并为驱虫、疫苗设置倒计时。</text>
        <view class="primary-btn" bindtap="onAdd">添加猫咪</view>
    </view>

    <view wx:else class="cat-list">
        <view
            class="cat-card"
            wx:for="{{cats}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onOpen"
        >
            <view class="cat-avatar">
                <image wx:if="{{item.avatar}}" class="avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
                <text wx:else class="avatar-emoji">{{item.emoji}}</text>
            </view>
            <view class="cat-main">
                <view class="cat-name-row">
                    <text class="cat-name">{{item.name}}</text>
                    <text wx:if="{{item.breedLabel}}" class="cat-breed">{{item.breedLabel}}</text>
                </view>
                <view class="cat-meta">
                    <text class="meta-strong">{{item.weightText}}</text>
                    <text wx:if="{{item.deltaText}}" class="meta-delta">{{item.deltaText}}</text>
                    <text class="meta-dot">·</text>
                    <text class="meta-plain">{{item.ageText}}</text>
                </view>
                <view class="badge-row">
                    <text wx:if="{{item.dewormBadge}}" class="badge badge-{{item.dewormLevel}}">{{item.dewormBadge}}</text>
                    <text wx:if="{{item.vaccineBadge}}" class="badge badge-{{item.vaccineLevel}}">{{item.vaccineBadge}}</text>
                    <text wx:if="{{!item.dewormBadge && !item.vaccineBadge}}" class="badge badge-muted">未设置提醒</text>
                </view>
            </view>
            <text class="chevron">›</text>
        </view>
    </view>

    <view wx:if="{{cats.length > 0}}" class="foot-tip">点击猫咪可查看体重曲线与健康计划</view>
</view>
