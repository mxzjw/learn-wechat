.head-text {
    max-width: 420rpx;
}

.add-btn {
    display: inline-flex;
    align-items: center;
    height: 64rpx;
    padding: 0 26rpx;
    border-radius: 32rpx;
    background: linear-gradient(135deg, #f6a35c, #e0762f);
    color: #ffffff;
    font-size: 25rpx;
    font-weight: 600;
    box-shadow: 0 8rpx 20rpx rgba(224, 118, 47, 0.24);
}

.add-btn:active {
    opacity: 0.85;
}

.cat-list {
    display: flex;
    flex-direction: column;
}

.cat-card {
    display: flex;
    align-items: center;
    background: #ffffff;
    border-radius: 30rpx;
    padding: 26rpx 24rpx;
    margin-bottom: 22rpx;
    box-shadow: 0 10rpx 30rpx rgba(171, 132, 96, 0.08);
}

.cat-card:active {
    transform: scale(0.995);
    background: #fffaf5;
}

.cat-avatar {
    width: 112rpx;
    height: 112rpx;
    border-radius: 56rpx;
    background: #fdf1e4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
}

.avatar-img {
    width: 112rpx;
    height: 112rpx;
}

.avatar-emoji {
    font-size: 58rpx;
    line-height: 1;
}

.cat-main {
    flex: 1;
    margin-left: 22rpx;
    min-width: 0;
}

.cat-name-row {
    display: flex;
    align-items: baseline;
}

.cat-name {
    font-size: 34rpx;
    font-weight: 700;
    color: #2b2320;
    max-width: 280rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cat-breed {
    margin-left: 12rpx;
    font-size: 22rpx;
    color: #a89c92;
    max-width: 200rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cat-meta {
    margin-top: 8rpx;
    display: flex;
    align-items: center;
    font-size: 24rpx;
}

.meta-strong {
    color: #4b3c30;
    font-weight: 600;
}

.meta-delta {
    margin-left: 10rpx;
    color: #a89c92;
    font-size: 22rpx;
}

.meta-dot {
    margin: 0 10rpx;
    color: #d8cec3;
}

.meta-plain {
    color: #a89c92;
}

.badge-row {
    margin-top: 12rpx;
    display: flex;
    flex-wrap: wrap;
}

.chevron {
    margin-left: 8rpx;
    font-size: 40rpx;
    color: #d8cec3;
}

.foot-tip {
    margin-top: 12rpx;
    text-align: center;
    font-size: 22rpx;
    color: #c1b6ab;
}
