.profile-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 22rpx 0 30rpx;
}

.avatar-wrap {
    position: relative;
    width: 160rpx;
    height: 160rpx;
    border-radius: 80rpx;
    background: #fdf1e4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 12rpx 26rpx rgba(171, 132, 96, 0.16);
}

.avatar-img {
    width: 160rpx;
    height: 160rpx;
}

.avatar-emoji {
    font-size: 82rpx;
    line-height: 1;
}

.avatar-edit {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 38rpx;
    line-height: 38rpx;
    text-align: center;
    font-size: 20rpx;
    color: #ffffff;
    background: rgba(43, 35, 32, 0.46);
}

.avatar-tip {
    margin-top: 16rpx;
    font-size: 22rpx;
    color: #a89c92;
}

.emoji-row {
    display: flex;
    margin-top: 14rpx;
}

.emoji-item {
    width: 66rpx;
    height: 66rpx;
    margin: 0 10rpx;
    border-radius: 33rpx;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 34rpx;
    border: 2rpx solid transparent;
}

.emoji-active {
    border-color: #e8823a;
    background: #fdf1e4;
}

.field {
    display: flex;
    align-items: center;
    padding: 24rpx 0;
}

.field-line {
    border-top: 2rpx solid #f5efe8;
}

.field-label {
    width: 160rpx;
    font-size: 28rpx;
    color: #6d6055;
    flex-shrink: 0;
}

.field-input {
    flex: 1;
    font-size: 30rpx;
    color: #2b2320;
}

.field-placeholder {
    color: #c9bdb2;
}

.field-hint {
    display: block;
    padding: 0 0 6rpx 160rpx;
    font-size: 22rpx;
    color: #b7a99b;
}

.picker-value {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    font-size: 30rpx;
    color: #2b2320;
    min-height: 44rpx;
}

.picker-empty {
    color: #c9bdb2;
}

.picker-arrow {
    margin-left: 10rpx;
    color: #d8cec3;
    font-size: 30rpx;
}

.chips {
    display: flex;
    flex-wrap: wrap;
    padding-left: 160rpx;
    padding-bottom: 10rpx;
}

.chips-tight {
    padding-left: 0;
    padding-top: 4rpx;
}

.chip {
    margin: 0 14rpx 14rpx 0;
    padding: 8rpx 22rpx;
    border-radius: 24rpx;
    background: #f8f2ea;
    color: #6d6055;
    font-size: 24rpx;
}

.chip:active {
    background: #f0e5d8;
}

.chip-plain {
    background: #ffffff;
    border: 2rpx solid #ece2d7;
    color: #a89c92;
}

.actions {
    margin-top: 12rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.action-main {
    width: 100%;
    height: 92rpx;
    border-radius: 46rpx;
    font-size: 32rpx;
}

.danger-link {
    margin-top: 30rpx;
    font-size: 26rpx;
    color: #c2433a;
    padding: 12rpx 24rpx;
}
